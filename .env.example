# Neon Postgres connection string (get from https://console.neon.tech)
# Uses pooler endpoint for serverless/short-lived connections
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Models Credentials
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
